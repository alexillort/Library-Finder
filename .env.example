# El modo demo no necesita variables. Nunca uses NEXT_PUBLIC_ para secretos.
# Activa solo después de ejecutar npm run mendeley:enable.
MENDELEY_SERVER=1
MENDELEY_CLIENT_ID=
MENDELEY_CLIENT_SECRET=
MENDELEY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/mendeley/callback
# 32 bytes aleatorios, representados como 64 caracteres hexadecimales.
SESSION_SECRET=
